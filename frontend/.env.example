# Base URL used by the typed API client (src/lib/api.ts).
#
# In development this stays as the relative path below: vite.config.ts proxies
# every `/api/*` request to the FastAPI backend on http://127.0.0.1:8000, so the
# browser never issues a cross-origin request.
#
# Point it at an absolute URL (e.g. https://api.example.com/api/v1) only when the
# frontend is served from a different origin than the API.
VITE_API_BASE_URL=/api/v1
