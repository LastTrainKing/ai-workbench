{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Workbench",
  "version": "3.0.0",
  "identifier": "com.aiworkbench.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Workbench",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#05070d",
        "visible": true,
        "devtools": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "AI Workbench",
    "copyright": "MIT Licensed",
    "category": "DeveloperTool",
    "shortDescription": "A private AI computer agent for Windows",
    "longDescription": "AI Workbench is a local-first AI computer agent. It runs its own knowledge base, task engine and tool system, and can read, edit, run and verify code on your machine within the permissions you grant it.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ]
      }
    }
  }
}
