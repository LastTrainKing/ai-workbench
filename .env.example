# =============================================================================
# AI Workbench — environment template
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# =============================================================================

# ----------------------------------------------------------------- application
APP_NAME=AI Workbench
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-32-plus-character-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------------- database
DATABASE_URL=postgresql+asyncpg://aiworkbench:aiworkbench@127.0.0.1:5432/aiworkbench
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----------------------------------------------------------------------- redis
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=true
CACHE_TTL_SEARCH_SECONDS=180
CACHE_TTL_PROMPT_SECONDS=600
CACHE_TTL_STATS_SECONDS=30

# ---------------------------------------------------------------------- qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_workbench_chunks
# 0 = detect the dimension from the embedding provider and create on demand
QDRANT_VECTOR_SIZE=0
QDRANT_DISTANCE=Cosine

# -------------------------------------------------------------- AI: chat model
# provider: openai_compatible | ollama | offline
AI_PROVIDER=openai_compatible
# Any OpenAI-compatible endpoint works:
#   DeepSeek   https://api.deepseek.com/v1            deepseek-chat
#   Qwen       https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   OpenAI     https://api.openai.com/v1              gpt-4o-mini
#   SiliconFlow https://api.siliconflow.cn/v1         Qwen/Qwen2.5-7B-Instruct
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=3
AI_BACKOFF_BASE_SECONDS=1.0

# ----------------------------------------------------------------- AI: embedding
# provider: openai_compatible | ollama | offline
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------- RAG
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=40
# weight of the dense leg in hybrid fusion: score = a*dense + (1-a)*sparse
HYBRID_ALPHA=0.6
RERANK_ENABLED=true

# ------------------------------------------------------------------ storage
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=.md,.markdown,.txt,.pdf

# ------------------------------------------------------------------- worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=1.0
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_JOB_SECONDS=900

# -------------------------------------------------------------- observability
LOG_LEVEL=INFO
LOG_JSON=false
METRICS_ENABLED=true

# =============================================================================
# Fully local mode (privacy): requires `ollama serve` + pulled models
# -----------------------------------------------------------------------------
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=qwen2.5:7b
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
#
# Deterministic offline engine (no key, no daemon — used automatically when a
# cloud key is missing so the product keeps working):
# AI_PROVIDER=offline
# EMBEDDING_PROVIDER=offline
WORKER_JOB_TIMEOUT_SECONDS=900
